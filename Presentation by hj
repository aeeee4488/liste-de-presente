<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bac Sef - الرياضيات - الحضور</title>
<script defer src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<style>
body{font-family:Arial;background:#0f172a;color:#fff;margin:0;padding:15px}
.card{background:#1e293b;padding:15px;border-radius:15px;margin:15px 0;border:1px solid #334155}
button{padding:12px 20px;border:none;border-radius:10px;font-weight:bold;cursor:pointer;margin:5px}
.btn-blue{background:#3b82f6;color:#fff}.btn-green{background:#22c55e;color:#fff}.btn-red{background:#ef4444;color:#fff}.btn-yellow{background:#eab308;color:#000}
input{padding:12px;border-radius:8px;width:80%;border:1px solid #475569;background:#0f172a;color:#fff;font-size:16px}
video{width:100%;border-radius:15px;border:2px solid #3b82f6;max-height:400px;background:#000}
.present{color:#22c55e} .absent{color:#ef4444}
#studentsList div{background:#0f172a;padding:8px;margin:5px 0;border-radius:8px;display:flex;justify-content:space-between}
</style>
</head>
<body>
<h2>📚 مادة الرياضيات - Bac Sef 1</h2>
<div class="card">
<h3>1- تسجيل تلميذ جديد</h3>
<input id="nameInput" placeholder="مثلا: احمد">
<br><br>
<button class="btn-blue" onclick="startEnroll()">📷 فتح الكاميرا</button>
<button class="btn-red" onclick="stopCamera()">⏹️ ايقاف</button>
<button class="btn-green" onclick="saveFace()">💾 حفظ الوجه</button>
<p id="status">⏳ جاري تحميل نموذج الوجه...</p>
<div id="studentsList"></div>
</div>
<div class="card">
<video id="video" autoplay muted playsinline></video>
</div>
<div class="card">
<h3>2- بدء حصة اليوم</h3>
<button class="btn-green" onclick="startAttendance()">▶️ بدء تسجيل الحضور</button>
<button class="btn-yellow" onclick="downloadExcel()">📥 تحميل Excel</button>
<button class="btn-red" onclick="clearAll()">🗑️ مسح الكل</button>
<h3>اللائحة:</h3>
<div id="attendanceList"></div>
</div>
<script>
let video=document.getElementById('video');
let statusEl=document.getElementById('status');
let nameInput=document.getElementById('nameInput');
let students = JSON.parse(localStorage.getItem('students') || '[]');
let currentDescriptor=null;
let stream=null;
let attendanceMode=false;
let attendance={};
async function loadModels(){
 try{
  const MODEL_URL='https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
  statusEl.textContent='⏳ تحميل النماذج...';
  await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
  await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
  await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
  statusEl.textContent='✅ جاهز! اكتب اسم التلميذ وافتح الكاميرا';
 }catch(e){
  try{
    const URL2='https://justadudewhohacks.github.io/face-api.js/models';
    await faceapi.nets.tinyFaceDetector.loadFromUri(URL2);
    await faceapi.nets.faceLandmark68Net.loadFromUri(URL2);
    await faceapi.nets.faceRecognitionNet.loadFromUri(URL2);
    statusEl.textContent='✅ جاهز!';
  }catch(e2){
    statusEl.textContent='❌ فشل تحميل النماذج: '+e2.message;
  }
 }
}
loadModels();
async function startEnroll(){
 attendanceMode=false;
 await startCamera();
 statusEl.textContent='👀 انظر للكاميرا...';
 detectEnroll();
}
async function startCamera(){
 if(stream) stopCamera();
 try{
  stream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}});
  video.srcObject=stream;
 }catch(err){ statusEl.textContent='❌ الكاميرا مرفوضة: '+err.message; }
}
function stopCamera(){
 if(stream){ stream.getTracks().forEach(t=>t.stop()); stream=null; }
}
async function detectEnroll(){
 if(!stream) return;
 if(attendanceMode) return;
 const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();
 if(detection){
  currentDescriptor = Array.from(detection.descriptor);
  statusEl.textContent='✅ وجه مكتشف! اضغط حفظ الوجه';
 }else{
  statusEl.textContent='🔍 لم أجد وجه... قرب وجهك';
 }
 if(!attendanceMode && stream) requestAnimationFrame(detectEnroll);
}
function saveFace(){
 let name=nameInput.value.trim();
 if(!name){ alert('اكتب الاسم أولا'); return; }
 if(!currentDescriptor){ alert('لم يتم التقاط الوجه'); return; }
 students.push({name, descriptor: currentDescriptor});
 localStorage.setItem('students', JSON.stringify(students));
 currentDescriptor=null;
 nameInput.value='';
 statusEl.textContent='✅ تم حفظ '+name;
 renderStudents();
}
function renderStudents(){
 let div=document.getElementById('studentsList');
 if(students.length==0){ div.innerHTML='<p>⚠️ سجل التلاميذ أولا - لا يوجد تلاميذ</p>'; }
 else{
  div.innerHTML = students.map((s,i)=>`<div><span>${s.name}</span><button onclick="removeStudent(${i})" style="background:#ef4444;color:#fff;padding:4px 8px;border-radius:5px">حذف</button></div>`).join('');
 }
 renderAttendance();
}
function removeStudent(i){ students.splice(i,1); localStorage.setItem('students', JSON.stringify(students)); renderStudents(); }
renderStudents();
async function startAttendance(){
 if(students.length==0){ alert('سجل التلاميذ أولا'); return; }
 attendanceMode=true;
 attendance={};
 students.forEach(s=>attendance[s.name]='غائب');
 await startCamera();
 statusEl.textContent='📷 بدأ تسجيل الحضور';
 detectAttendance();
}
async function detectAttendance(){
 if(!attendanceMode) return;
 if(!stream) return;
 const detections = await faceapi.detectAllFaces(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptors();
 if(detections.length>0){
  detections.forEach(det=>{
   let best=null, bestDist=0.6;
   students.forEach(s=>{
    let dist = faceapi.euclideanDistance(det.descriptor, new Float32Array(s.descriptor));
    if(dist<bestDist){ bestDist=dist; best=s.name; }
   });
   if(best){ attendance[best]='حاضر'; }
  });
  renderAttendance();
 }
 if(attendanceMode) setTimeout(detectAttendance, 800);
}
function renderAttendance(){
 let div=document.getElementById('attendanceList');
 div.innerHTML = Object.entries(attendance).map(([n,st])=>`<div class="${st=='حاضر'?'present':'absent'}">${n}: ${st}</div>`).join('') || students.map(s=>`<div>${s.name}: لم تبدأ الحصة</div>`).join('');
}
function downloadExcel(){
 if(Object.keys(attendance).length==0){ alert('ابدأ الحصة أولا'); return; }
 let csv="الاسم,الحالة\n"+Object.entries(attendance).map(([n,s])=>`${n},${s}`).join("\n");
 let blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
 let a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='attendance_'+new Date().toISOString().slice(0,10)+'.csv'; a.click();
}
function clearAll(){ if(confirm('مسح كل التلاميذ؟')){ students=[]; localStorage.clear(); renderStudents(); statusEl.textContent='تم المسح'; } }
</script>
</body>
</html>
